# ==============================================================================
# GrantLoom Environment Secrets (.env)
# STRICT RULE: Put ONLY private secrets / API keys here.
# Do NOT put operational settings, limits, or model names here (use config/config.json).
# ==============================================================================

# Master API Key for single-tenant server authorization (X-API-Key)
MASTER_API_KEY=

# Optional upstream API key for server-side evaluation/fallback (BYOK header preferred)
OPENROUTER_API_KEY=
